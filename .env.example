PROJECT_ROOT=/path/to/your/project
ALLOWED_PORTS=3000,5173,8080,4200,4000,8000
# Broad default dev-workflow allowlist. "npm run" (no script name) matches
# any "npm run <script>" via prefix matching, so you don't need to list
# every script in your package.json individually. Narrow this down if you
# want a stricter allowlist for a given project.
ALLOWED_COMMANDS=npm install,npm ci,npm run,npm test,npm outdated,npm audit,npm list,npm --version,npx tsc --noEmit,npx eslint,npx prettier --check,npx playwright test,npx vitest,npx jest,npx next build,npx next lint,yarn install,yarn build,yarn test,yarn lint,pnpm install,pnpm build,pnpm test,pnpm lint,git status,git diff,git log,git branch,git show,git remote -v,git fetch,git pull,git add,git commit,git stash,git checkout,git push,python -m venv,python -m pytest,pytest,pip install,pip list,pip freeze,python --version,docker compose up,docker compose down,docker compose build,docker compose ps,docker ps,docker --version,node --version
# ALLOWED_WRITE_DIRS=/path/to/your/project/src
HTTP_PORT=3333
# MCP_API_KEY=your-secret-key-here
